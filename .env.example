# ============================================
# Aqar Mudar — environment configuration
# ============================================
# Copy this file to `.env` and fill in the values you need.

NODE_ENV="development"

# ---- Database (Postgres) ----
# Local dev via docker-compose:
DATABASE_URL="postgresql://aqarmudar:aqarmudar@localhost:5432/aqarmudar"

# ---- Docker Compose host ports ----
# If 3000/5432 are already taken on your machine, change these — but the
# port in DATABASE_URL above must match DB_PORT, since Next.js doesn't
# expand ${DB_PORT} inside other .env values. Example: DB_PORT=5544 means
# DATABASE_URL must end in ...@localhost:5544/aqarmudar.
APP_PORT=3000
DB_PORT=5432

# ---- NextAuth ----
NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"

# ---- File Storage ----
# "local" writes to public/uploads; "s3" uses any S3-compatible bucket (AWS/R2/MinIO).
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="me-south-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ---- Email ----
# "console" logs to stdout; "resend" sends via https://resend.com
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="Aqar Mudar <noreply@aqarmudar.sa>"

# ---- SMS / OTP ----
# "console" logs codes; "twilio" sends real SMS
SMS_DRIVER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ---- Payments — Moyasar (Saudi-native, RECOMMENDED) ----
# https://moyasar.com — supports Mada, Apple Pay, Visa/Mastercard, STC Pay
MOYASAR_SECRET_KEY=""
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_WEBHOOK_SECRET=""

# ---- Payments — Stripe (alternative / international) ----
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- Monitoring — Sentry ----
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ---- Analytics — Google Analytics 4 ----
NEXT_PUBLIC_GA_ID=""

# ---- Nafath (identity verification) ----
# Requires official partnership with the Nafath program.
NAFATH_API_URL=""
NAFATH_CLIENT_ID=""
NAFATH_CLIENT_SECRET=""

# ---- Product feature flags ----
# Fractional / partial-sale (بيع جزئي). Off by default — waiting on the
# CMA/SPV licensing route. The DB fields and /invest route stay in place;
# this flag hides them in the UI and enforces the "قريبًا" state.
FEATURE_PARTIAL_SALE="false"
